{
  "openapi": "3.1.1",
  "info": {
    "title": "SalesDashboard.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/"
    }
  ],
  "paths": {
    "/api/dashboard": {
      "get": {
        "tags": [
          "SalesDashboard.Api"
        ],
        "operationId": "GetDashboard",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "preset",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rankingBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/sales": {
      "get": {
        "tags": [
          "SalesDashboard.Api"
        ],
        "operationId": "GetSales",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "preset",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "SalesDashboard.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryDto": {
        "required": [
          "id",
          "name",
          "revenue",
          "grossProfit",
          "salesCount",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "revenue": {
            "type": "string"
          },
          "grossProfit": {
            "type": "string"
          },
          "salesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "ChangeDto": {
        "required": [
          "revenuePercent",
          "grossProfitPercent",
          "salesCountPercent",
          "averageCheckPercent",
          "marginPoints"
        ],
        "type": "object",
        "properties": {
          "revenuePercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "grossProfitPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "salesCountPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "averageCheckPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "marginPoints": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ComparisonDto": {
        "required": [
          "period",
          "metrics",
          "change"
        ],
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/PeriodDto"
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricsDto"
          },
          "change": {
            "$ref": "#/components/schemas/ChangeDto"
          }
        }
      },
      "CustomerDto": {
        "required": [
          "id",
          "name",
          "company",
          "segment"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          }
        }
      },
      "DashboardDto": {
        "required": [
          "period",
          "currency",
          "rankingBy",
          "kpis",
          "ranking",
          "series",
          "categories",
          "topProducts",
          "comparison"
        ],
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/PeriodDto"
          },
          "currency": {
            "type": "string"
          },
          "rankingBy": {
            "type": "string"
          },
          "kpis": {
            "$ref": "#/components/schemas/KpisDto"
          },
          "ranking": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankingDto"
            }
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayDto"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryDto"
            }
          },
          "topProducts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductDto"
            }
          },
          "comparison": {
            "$ref": "#/components/schemas/ComparisonDto"
          }
        }
      },
      "DayDto": {
        "required": [
          "date",
          "revenue",
          "grossProfit",
          "salesCount"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "revenue": {
            "type": "string"
          },
          "grossProfit": {
            "type": "string"
          },
          "salesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "KpisDto": {
        "required": [
          "revenue",
          "cost",
          "grossProfit",
          "salesCount",
          "averageCheck",
          "margin",
          "bestManager"
        ],
        "type": "object",
        "properties": {
          "revenue": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          },
          "grossProfit": {
            "type": "string"
          },
          "salesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "averageCheck": {
            "type": [
              "null",
              "string"
            ]
          },
          "margin": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "bestManager": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ManagerDto"
              }
            ]
          }
        }
      },
      "ManagerDto": {
        "required": [
          "id",
          "name",
          "team",
          "position",
          "isActive",
          "initials",
          "avatarUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "initials": {
            "type": "string"
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MetricsDto": {
        "required": [
          "revenue",
          "cost",
          "grossProfit",
          "salesCount",
          "averageCheck",
          "margin"
        ],
        "type": "object",
        "properties": {
          "revenue": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          },
          "grossProfit": {
            "type": "string"
          },
          "salesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "averageCheck": {
            "type": [
              "null",
              "string"
            ]
          },
          "margin": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "PeriodDto": {
        "required": [
          "from",
          "to"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string",
            "default": "Europe/Moscow"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProductDto": {
        "required": [
          "id",
          "name",
          "categoryId",
          "revenue",
          "grossProfit",
          "salesCount",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "categoryId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "revenue": {
            "type": "string"
          },
          "grossProfit": {
            "type": "string"
          },
          "salesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "RankingDto": {
        "required": [
          "rank",
          "manager",
          "metrics"
        ],
        "type": "object",
        "properties": {
          "rank": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "manager": {
            "$ref": "#/components/schemas/ManagerDto"
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricsDto"
          }
        }
      },
      "SaleDto": {
        "required": [
          "id",
          "soldAt",
          "manager",
          "customer",
          "status",
          "includedInKpis",
          "amount",
          "grossProfit",
          "items"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "soldAt": {
            "type": "string",
            "format": "date-time"
          },
          "manager": {
            "$ref": "#/components/schemas/ManagerDto"
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerDto"
          },
          "status": {
            "type": "string"
          },
          "includedInKpis": {
            "type": "boolean"
          },
          "amount": {
            "type": "string"
          },
          "grossProfit": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleItemDto"
            }
          }
        }
      },
      "SaleItemDto": {
        "required": [
          "productId",
          "productName",
          "quantity",
          "unitPrice",
          "unitCost"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "productName": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unitPrice": {
            "type": "string"
          },
          "unitCost": {
            "type": "string"
          }
        }
      },
      "SalesDto": {
        "required": [
          "period",
          "currency",
          "limit",
          "items"
        ],
        "type": "object",
        "properties": {
          "period": {
            "$ref": "#/components/schemas/PeriodDto"
          },
          "currency": {
            "type": "string"
          },
          "limit": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleDto"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "SalesDashboard.Api"
    }
  ]
}